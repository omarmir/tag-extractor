{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": [
      "bun",
      "vitest/globals"
    ]
  },
  "include": [
    "library/src/**/*.ts",
    "tools/**/*.ts",
    "docs/**/*.ts"
  ]
}
